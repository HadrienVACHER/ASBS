#!/bin/bash
#PBS -N lj13_asbs_stein
#PBS -P gs_ccds_haidang.dau
#PBS -q gpu_as
#PBS -l walltime=120:00:00
#PBS -l select=1:ncpus=4:ngpus=1
#PBS -j oe

cd "$PBS_O_WORKDIR"

module load anaconda/2025
eval "$(/usr/local/anaconda2025/bin/conda shell.bash hook)"
conda activate BMS

: "${SEED:?SEED must be set, e.g. qsub -v SEED=0 scripts/lj13_asbs_stein.pbs}"

python train.py \
  experiment=lj13_asbs_stein \
  seed=${SEED} \
  exp_name=lj13_asbs_stein_seed${SEED} \
  hydra.run.dir=results/lj13_asbs_stein/seed${SEED}
